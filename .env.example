# Root reference only. Copy relevant values into app/backend/.env,
# app/backend/.env.local, or app/frontend/.env.local.

# Shared
NODE_ENV=development
FRONTEND_URL=http://localhost:3002

# Backend server
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salesape?schema=public
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-32-byte-hex-key
LOG_LEVEL=debug

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key
SUPABASE_BUCKET_WEBSITES=websites
SUPABASE_BUCKET_VIDEOS=videos
SUPABASE_BUCKET_AUDIO=audio
SUPABASE_BUCKET_ASSETS=generated-assets

# AI and content providers
OPENAI_API_KEY=replace-with-openai-key
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REPURPOSE_MODEL_NON_STREAM=gpt-4o-mini
OPENAI_REPURPOSE_MODEL_STREAM=gpt-5-mini
ANTHROPIC_API_KEY=
UNSPLASH_ACCESS_KEY=

# Queues and cache
QUEUE_PROVIDER=pgboss
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_SKIP_WORKERS=true
REDIS_SKIP_READY=false
REDIS_CONNECT_TIMEOUT=5000
REDIS_ENABLE_OFFLINE_QUEUE=true

# Supabase/Redis readiness switches
SUPABASE_SKIP_READY=false

# Email
SENDGRID_API_KEY=
EMAIL_ENABLED=false
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=admin@salesape.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@salesape.com

# SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_PAGESPEED_API_KEY=
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT_MS=120000
PAGESPEED_MAX_ATTEMPTS=1
AUTO_PAGESPEED_AUDIT_ENABLED=true
AUTO_PAGESPEED_AUDIT_INTERVAL_MINUTES=30
AUTO_PAGESPEED_AUDIT_MIN_INTERVAL_MINUTES=60

# Auth providers
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=

# Abuse prevention
RECAPTCHA_SECRET=
RECAPTCHA_KEY=

# Beyond Presence / external LLM bridge
BEYOND_PRESENCE_API_KEY=
BEYOND_PRESENCE_AGENT_ID=
BEYOND_PRESENCE_AGENT_URL=
BEYOND_PRESENCE_AVATAR_ID=
BEYOND_EXTERNAL_LLM_SECRET=

# Frontend
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=
