# Root reference only. Copy the relevant values into app/backend/.env and app/frontend/.env.local.

# Shared
NODE_ENV=development
FRONTEND_URL=http://localhost:3002

# Backend server
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salesape?schema=public
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-32-byte-hex-key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# AI providers
OPENAI_API_KEY=replace-with-openai-key
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Queues/cache
REDIS_URL=redis://localhost:6379
REDIS_SKIP_WORKERS=true

# Optional integrations
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BEYOND_PRESENCE_API_KEY=
BEYOND_PRESENCE_AGENT_ID=
BEYOND_PRESENCE_AGENT_URL=
BEYOND_PRESENCE_AVATAR_ID=

# Frontend
VITE_API_BASE_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
