{
  "name": "salesape-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix app/backend run dev",
    "dev:frontend": "npm --prefix app/frontend run dev",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix app/frontend run build",
    "typecheck:backend": "npm --prefix app/backend run typecheck",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix app/backend run test",
    "test:frontend": "npm --prefix app/frontend run test -- --run",
    "lint:frontend": "npm --prefix app/frontend run lint",
    "prisma:generate": "npm --prefix app/backend exec -- prisma generate --schema prisma/schema.prisma",
    "install:all": "npm install && npm --prefix app/backend install && npm --prefix app/frontend install"
  },
  "devDependencies": {
    "@prisma/client": "^7.3.0",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.1.0",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^7.0.9",
    "prisma": "^7.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "cheerio": "^1.2.0",
    "node-fetch": "^3.3.2"
  }
}
